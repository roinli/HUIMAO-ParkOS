<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huimao.system.mapper.SysTenantMapper">

    <resultMap type="com.huimao.system.domain.SysTenant" id="SysTenantResult">
        <result property="id"    column="id"    />
        <result property="tenantName"    column="tenant_name"    />
        <result property="userName"    column="user_name"    />
        <result property="userPhone"    column="user_phone"    />
        <result property="userEmail"    column="user_email"    />
        <result property="tenantPackage"    column="tenant_package"    />
        <result property="tenantTime"    column="tenant_time"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="parkingLotCount"    column="parking_lot_count"    />
        <result property="balanceAmount"    column="balance_amount"    />
    </resultMap>

    <sql id="selectSysTenantVo">
        select t.id, t.tenant_name, t.user_name, t.user_phone, t.user_email, t.tenant_package, t.tenant_time,
               t.status, t.del_flag, t.create_by, t.create_time, t.update_by, t.update_time, t.remark,
               ifnull(lot.parking_lot_count, 0) as parking_lot_count,
               ifnull(account.balance_amount, 0) as balance_amount
        from sys_tenant t
        left join (
            select tenant_id, count(1) as parking_lot_count
            from parking_lot
            where del_flag = '0'
            group by tenant_id
        ) lot on lot.tenant_id = t.id
        left join parking_account account on account.tenant_id = t.id
    </sql>

    <select id="selectSysTenantList"   resultMap="SysTenantResult">
        <include refid="selectSysTenantVo"/>
        <where>
            <if test="query.tenantName != null  and query.tenantName != ''"> and t.tenant_name like concat('%', #{query.tenantName}, '%')</if>
            <if test="query.userName != null  and query.userName != ''"> and t.user_name like concat('%', #{query.userName}, '%')</if>
            <if test="query.userPhone != null  and query.userPhone != ''"> and t.user_phone = #{query.userPhone}</if>
            <if test="query.params.beginTenantTime != null and query.params.beginTenantTime != '' and query.params.endTenantTime != null and query.params.endTenantTime != ''">
             and t.tenant_time between #{query.params.beginTenantTime} and #{query.params.endTenantTime}</if>
            <if test="query.status != null  and query.status != ''"> and t.status = #{query.status}</if>
        </where>
    </select>

    <delete id="deleteSysTenantByIds" parameterType="String">
        delete from sys_tenant where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
