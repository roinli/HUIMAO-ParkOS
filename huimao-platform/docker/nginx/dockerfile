# 基础镜像
FROM nginx
# author
MAINTAINER huimao

# 挂载目录
VOLUME /home/huimao/projects/huimao-ui
# 创建目录
RUN mkdir -p /home/huimao/projects/huimao-ui
# 指定路径
WORKDIR /home/huimao/projects/huimao-ui
# 复制conf文件到路径
COPY ./conf/nginx.conf /etc/nginx/nginx.conf
# 复制html文件到路径
COPY ./html/dist /home/huimao/projects/huimao-ui
